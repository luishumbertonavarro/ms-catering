  "interactions": [
    {
      "description": "una petición para obtener el calendario de un paciente",
      "pending": false,
      "providerStates": [
        {
          "name": "existe un calendario activo",
          "params": {
            "calendario_id": "44444444-4444-4444-8444-444444444444",
            "paciente_id": "55555555-5555-4555-8555-555555555555"
          }
        }
      ],
      "request": {
        "headers": {
          "Accept": [
            "application/json"
          ]
        },
        "method": "GET",
        "path": "/calendarios/paciente/55555555-5555-4555-8555-555555555555"
