      "item": [
        {
          "name": "1. Crear calendario (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Un paciente nuevo en cada corrida: la colección es repetible.",
                  "pm.collectionVariables.set('paciente_id', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const cal = pm.response.json();",
                  "pm.collectionVariables.set('calendario_id', cal.id);",
                  "",
                  "pm.test('El calendario nace ACTIVO con una entrega por día', function () {",
                  "    pm.expect(cal.estado).to.eql('ACTIVO');",
                  "    pm.expect(cal.total_dias).to.eql(15);",
                  "    pm.expect(cal.entregas).to.have.lengthOf(15);",
                  "});",
                  "",
                  "pm.test('Todas las entregas nacen PROGRAMADAS en la dirección inicial', function () {",
                  "    cal.entregas.forEach(e => {",
                  "        pm.expect(e.estado).to.eql('PROGRAMADA');",
                  "        pm.expect(e.direccion).to.eql('Av. Banzer 123');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/calendarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "calendarios"
              ]
